# State and output — never want these in the image
data/
config/profiles/
logs/
*.db
*.sqlite

# Dev artifacts
.venv/
.env
.env.*
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Git and CI
.git/
.github/
.gitignore

# Documentation — doesn't belong at runtime
docs/
*.md
!requirements.txt

# IDE
.vscode/
.idea/
*.swp

# Build artifacts
dist/
build/
*.egg-info/

# Tests and fixtures — never executed inside the production image
tests/
ma_poc/tests/

# Jugnu-specific runtime state (profiles are in Postgres in deployed system)
ma_poc/config/profiles/
ma_poc/data/
ma_poc/logs/

# Worktrees and agent scratch space (can live under ma_poc/)
ma_poc/.claude/

# Nested Node.js / frontend projects that happen to live under ma_poc/
# Not part of the Python runtime image. The Python modules in ma_poc/services/
# (*.py) are kept; only the TS/Node sub-tree is excluded.
ma_poc/frontend/
ma_poc/services/node_modules/
ma_poc/services/src/
ma_poc/services/dist/
ma_poc/services/package.json
ma_poc/services/package-lock.json
ma_poc/services/tsconfig*.json
ma_poc/services/vite.config.*
ma_poc/services/*.lock

# Data files in config/ — loaded at runtime from Postgres/GCS or via the
# sync-csv deploy step. Small YAML/JSON config (business_rules, api_catalogue,
# prompts/) stays; bulk CSVs do not — except the two CSVs the build itself
# needs: verify_csv_mapping.py + validate_deployment.py read these at image
# build time to produce csv_floorplan_mapping.json and assert the catalog
# loads with ≥1 000 indexed properties, so they have to be in the context.
ma_poc/config/*.csv
!ma_poc/config/Floorplan- comparisons.csv
!ma_poc/config/properties.csv

# Misc large/irrelevant-to-runtime dirs under ma_poc/
ma_poc/output/
ma_poc/brightdata/
